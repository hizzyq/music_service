FROM node:20-alpine

RUN apk update && apk add --no-cache \
    ruby \
    ruby-dev \
    build-base \
    libpq-dev \
    ffmpeg \
    yaml-dev \
    git \
    tzdata \
    postgresql-client

RUN gem install bundler:4.0.21 --no-document

WORKDIR /app

COPY Gemfile Gemfile.lock ./
RUN bundle config set --local without 'deployment' && bundle install

COPY . .

EXPOSE 3000

ENTRYPOINT []
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3000"]

